{
  // Cloudflare Workers mirror of kairon.xyz (Phase 1: static mirror; no DNS change).
  // Parity target: vercel.json - static dist/ output, cleanUrls, /api CORS+cache,
  // llms content-type, /ingest reverse proxy to PostHog EU.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kairon-xyz",
  "compatibility_date": "2026-10-30",
  "main": "src/worker.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page"
  }
}
